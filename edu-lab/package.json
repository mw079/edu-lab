{
  "name": "edu-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Teacher-facing generator for interactive science lessons.",
  "scripts": {
    "dev": "concurrently -k -n server,web \"PORT=8787 tsx watch server/index.ts\" \"vite\"",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate.ts",
    "regenerate": "tsx scripts/regenerate.ts",
    "eval": "tsx scripts/eval.ts",
    "export": "tsx scripts/export.ts",
    "check": "tsx scripts/check.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "katex": "^0.16.11",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
